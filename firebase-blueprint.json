{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "studentId": { "type": "string" },
        "schoolEmail": { "type": "string" },
        "course": { "type": "string" },
        "yearLevel": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "avatar": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "studentId", "schoolEmail", "role"]
    },
    "Item": {
      "title": "Item",
      "description": "Lost or found item report",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "location": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "lost", "found", "claimed", "under-review", "declined"] },
        "type": { "type": "string", "enum": ["lost", "found"] },
        "imageUrl": { "type": "string" },
        "reporterId": { "type": "string" },
        "currentPossession": { "type": "string", "enum": ["reporter", "csc-office"] },
        "claimedAt": { "type": "string", "format": "date-time" },
        "claimedBy": { "type": "string" },
        "approvedBy": { "type": "string" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "location", "date", "status", "type", "reporterId"]
    },
    "Claim": {
      "title": "Claim",
      "description": "Item ownership claim request",
      "type": "object",
      "properties": {
        "itemId": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "date": { "type": "string", "format": "date-time" },
        "message": { "type": "string" },
        "proofImageUrl": { "type": "string" },
        "verificationId": { "type": "string" }
      },
      "required": ["itemId", "userId", "status", "date", "message", "verificationId"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Comment on an item report",
      "type": "object",
      "properties": {
        "itemId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string", "enum": ["student", "admin"] },
        "content": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "isDeleted": { "type": "boolean" },
        "isFlagged": { "type": "boolean" },
        "isHidden": { "type": "boolean" },
        "parentId": { "type": "string" }
      },
      "required": ["itemId", "userId", "userName", "userRole", "content", "date"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["match", "status-update", "system"] },
        "date": { "type": "string", "format": "date-time" },
        "read": { "type": "boolean" },
        "itemId": { "type": "string" }
      },
      "required": ["userId", "message", "type", "date", "read"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "Collection of user profiles"
    },
    "items": {
      "schema": "Item",
      "description": "Collection of lost and found item reports"
    },
    "claims": {
      "schema": "Claim",
      "description": "Collection of ownership claims"
    },
    "comments": {
      "schema": "Comment",
      "description": "Collection of comments on items"
    },
    "notifications": {
      "schema": "Notification",
      "description": "Collection of user notifications"
    }
  }
}
