rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserDocData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'xanderjamesmata951@gmail.com' ||
        request.auth.token.email == 'sphinxeins@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserDocData(request.auth.uid).role == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- ENTITY VALIDATIONS ---

    function isValidUser(data) {
      return data.fullName is string && data.fullName.size() <= 100 &&
             (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 100)) &&
             data.schoolEmail is string && data.schoolEmail.size() <= 100 &&
             data.role in ['student', 'admin'] &&
             (!('course' in data) || (data.course is string && data.course.size() <= 100)) &&
             (!('yearLevel' in data) || (data.yearLevel is string && data.yearLevel.size() <= 20)) &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 1500000));
    }

    function isValidItem(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             data.category is string && data.category.size() <= 50 &&
             data.location is string && data.location.size() <= 100 &&
             data.date is string &&
             data.status in ['pending', 'lost', 'found', 'claimed', 'under-review', 'declined'] &&
             data.type in ['lost', 'found'] &&
             data.reporterId is string && isValidId(data.reporterId) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1500000)) &&
             (!('currentPossession' in data) || (data.currentPossession in ['reporter', 'csc-office']));
    }

    function isValidClaim(data) {
      return data.itemId is string && isValidId(data.itemId) &&
             data.userId is string && isValidId(data.userId) &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.date is string &&
             data.message is string && data.message.size() <= 1000 &&
             data.verificationId is string && data.verificationId.size() <= 50 &&
             (!('proofImageUrl' in data) || (data.proofImageUrl is string && data.proofImageUrl.size() <= 1500000));
    }

    // --- MATCH BLOCKS ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) && (
                    incoming().role == 'student' ||
                    (incoming().role == 'admin' && (request.auth.token.email == 'xanderjamesmata951@gmail.com' || request.auth.token.email == 'sphinxeins@gmail.com'))
                    ) &&
                    incoming().keys().hasAll(['fullName', 'schoolEmail', 'role']) && 
                    incoming().keys().size() >= 3;
      
      allow update: if isSignedIn() && isValidUser(incoming()) && (
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'course', 'yearLevel', 'avatar']) && incoming().role == existing().role) ||
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role']))
      );
    }

    match /items/{itemId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(incoming().reporterId) && isValidItem(incoming()) && incoming().status == 'pending';
      
      allow update: if isSignedIn() && isValidItem(incoming()) && (
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasAny(['status', 'currentPossession', 'claimedBy', 'claimedAt', 'approvedBy', 'isArchived'])) ||
        (isOwner(existing().reporterId) && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'location', 'imageUrl', 'date'])) ||
        (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['status']) && incoming().status == 'under-review' && existing().status in ['lost', 'found'])
      );
      
      allow delete: if isAdmin();
    }

    match /claims/{claimId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        get(/databases/$(database)/documents/items/$(resource.data.itemId)).data.reporterId == request.auth.uid
      );
      
      allow create: if isSignedIn() && isOwner(incoming().userId) && isValidClaim(incoming()) && 
                    incoming().status == 'pending' && exists(/databases/$(database)/documents/items/$(incoming().itemId));
      
      allow update: if isSignedIn() && (
        (isAdmin() && isValidClaim(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['status']))
      );
      
      allow delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(incoming().userId) && isValidId(incoming().itemId);
      allow update, delete: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
    }

    match /notifications/{notifId} {
      allow read, delete: if isSignedIn() && isOwner(resource.data.userId);
      allow update: if isSignedIn() && isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow create: if isSignedIn(); // Allow users to notify each other based on app events
    }
  }
}
