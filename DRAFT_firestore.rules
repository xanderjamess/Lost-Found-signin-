rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'xanderjamesmata951@gmail.com' ||
        request.auth.token.email == 'admin@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- ENTITY VALIDATIONS ---

    function isValidUser(data) {
      return data.fullName is string && data.fullName.size() <= 100 &&
             data.studentId is string && data.studentId.size() <= 20 &&
             data.schoolEmail is string && data.schoolEmail.size() <= 100 &&
             data.schoolEmail.matches('.*@.*\\.edu\\.ph$') &&
             data.role in ['student', 'admin'] &&
             (!('course' in data) || (data.course is string && data.course.size() <= 100)) &&
             (!('yearLevel' in data) || (data.yearLevel is string && data.yearLevel.size() <= 20)) &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 1500000));
    }

    function isValidItem(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             data.category is string && data.category.size() <= 50 &&
             data.location is string && data.location.size() <= 100 &&
             data.status in ['pending', 'lost', 'found', 'claimed', 'under-review', 'declined'] &&
             data.type in ['lost', 'found'] &&
             data.reporterId is string && isValidId(data.reporterId) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1500000));
    }

    function isValidClaim(data) {
      return data.itemId is string && isValidId(data.itemId) &&
             data.userId is string && isValidId(data.userId) &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.message is string && data.message.size() <= 1000 &&
             data.verificationId is string && data.verificationId.size() <= 50 &&
             (!('proofImageUrl' in data) || (data.proofImageUrl is string && data.proofImageUrl.size() <= 1500000));
    }

    // --- MATCH BLOCKS ---

    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      // Only allow listing public info if needed, but for now restrict
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) && (
                    incoming().role == 'student' ||
                    (incoming().role == 'admin' && (request.auth.token.email == 'xanderjamesmata951@gmail.com' || request.auth.token.email == 'admin@gmail.com'))
                    );
      
      allow update: if isSignedIn() && (
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'course', 'yearLevel', 'avatar']) && isValidUser(incoming())) ||
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role']) && isValidUser(incoming()))
      );
    }

    match /items/{itemId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Queries should filter by status if public

      allow create: if isSignedIn() && isOwner(incoming().reporterId) && isValidItem(incoming()) && incoming().status == 'pending';
      
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isOwner(existing().reporterId) && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'location', 'imageUrl']) && isValidItem(incoming()))
      );
      
      allow delete: if isAdmin();
    }

    match /claims/{claimId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || (resource.data.userId == request.auth.uid));

      allow create: if isSignedIn() && isOwner(incoming().userId) && isValidClaim(incoming()) && 
                    incoming().status == 'pending' && exists(/databases/$(database)/documents/items/$(incoming().itemId));
      
      allow update: if isSignedIn() && (
        isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status']) && isValidClaim(incoming())
      );
      
      allow delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(incoming().userId) && incoming().itemId is string;
      allow update, delete: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn() && isOwner(resource.data.userId);
      allow update: if isSignedIn() && isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
      
      // System handles creation, but let's allow it for now if we don't have a backend
      allow create: if isAdmin() || (isSignedIn() && isOwner(incoming().userId));
    }
  }
}
